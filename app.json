{
  "expo": {
    "name": "Tent",
    "slug": "MyAppTemplate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tent",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.anonymous.MyAppTemplate"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#059669",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.MyAppTemplate"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#059669",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Tent to access photos for cash-book entries.",
          "cameraPermission": "Allow Tent to take photos for cash-book entries.",
          "microphonePermission": false
        }
      ],
      "@react-native-vector-icons/ionicons",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#059669",
          "enableRemoteNotifications": false,
          "defaultChannel": "reminders"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Tent to access your photo library to save invoice images.",
          "savePhotosPermission": "Allow Tent to save invoice images to your photo library.",
          "granularPermissions": ["photo"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ad4552ab-33d1-40ed-9c96-9b18c99f8145"
      }
    }
  }
}
